      "values": [
        ["0", {"en": "Off (game setting)", "fr": "Désactivé (réglage du jeu)"}],
        ["2", "2×"],
        ["4", "4×"],
        ["8", "8×"],
        ["16", "16×"]
      ],
      "default": "0"
    },
