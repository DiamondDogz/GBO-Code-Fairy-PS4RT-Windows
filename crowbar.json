      "values": [
        ["off", {"en": "Off (original image)", "fr": "Désactivée (image d’origine)"}],
        ["fsr1", "FSR 1"],
        ["fsr3", "FSR 3.1"],
        ["fsr4", "FSR 4"],
        ["fsr411", "FSR 4.1.1"],
        ["taa", "TAA"],
        ["dlss", "DLSS"]
