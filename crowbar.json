{
  "crowbar": 1,
  "name": "Sieg Zeon",
  "game": "gundam-code-fairy",
  "titleIds": ["CUSA28763"],
  "data": "out/{titleId}",
  "settings": "{data}/ps4rt.ini",
  "launch": {
    "windows": ["python/python.exe", "scripts/ps4rt_launch.py", "--game", "{game}"]
  },
  "features": {
    "trophies": true,
    "dlc": ["--dlc-pkg", "{file}"],
    "updatePkg": ["--update-pkg", "{file}"],
    "updateFolder": ["--update-extracted", "{dir}"],
    "noDialogs": ["--no-dialogs"]
  },
  "options": [
    {
      "key": "display_mode",
      "label": {"en": "Display", "fr": "Affichage"},
      "values": [
        ["windowed", {"en": "Windowed", "fr": "Fenêtré"}],
        ["borderless", {"en": "Borderless", "fr": "Plein écran fenêtré"}],
        ["fullscreen", {"en": "Fullscreen", "fr": "Plein écran"}]
      ],
      "default": "windowed"
    },
    {
      "key": "graphics_quality",
      "label": {"en": "Graphics quality", "fr": "Qualité graphique"},
      "hint": {"en": "Smaller shadow maps for modest graphics cards · next launch", "fr": "Ombres plus légères pour les cartes modestes · au prochain lancement"},
      "values": [
        ["max", {"en": "Max (original)", "fr": "Maximale (d’origine)"}],
        ["medium", {"en": "Medium", "fr": "Moyenne"}],
        ["low", {"en": "Low", "fr": "Basse"}]
      ],
      "default": "max"
    },
    {
      "key": "render_resolution",
      "label": {"en": "Internal resolution", "fr": "Résolution interne"},
      "hint": {"en": "16:9, 21:9, 24:9 and 32:9 · next launch", "fr": "16:9, 21:9, 24:9 et 32:9 · au prochain lancement"},
      "values": [
        ["540p", "1024 × 576"],
        ["720p", "1280 × 720"],
        ["native", {"en": "1920 × 1080 (native)", "fr": "1920 × 1080 (native)"}],
        ["1440p", "2560 × 1440"],
        ["2160p", "3840 × 2160 (4K)"],
        ["2560x1080", "2560 × 1080 (21:9)"],
        ["3440x1440", "3440 × 1440 (21:9)"],
        ["3840x1440", "3840 × 1440 (24:9)"],
        ["3840x1080", "3840 × 1080 (32:9)"],
        ["5120x1440", "5120 × 1440 (32:9)"]
      ],
      "default": "native"
    },
    {
      "key": "output_res",
      "label": {"en": "Upscaler output", "fr": "Sortie de la mise à l’échelle"},
      "hint": {"en": "Larger than the internal resolution, same shape", "fr": "Plus grande que la résolution interne, même format"},
      "values": [
        ["native", {"en": "Native (internal resolution)", "fr": "Native (résolution interne)"}],
        ["1920x1080", "1920 × 1080"],
        ["2560x1440", "2560 × 1440"],
        ["3840x2160", "3840 × 2160 (4K)"],
        ["3440x1440", "3440 × 1440 (21:9)"],
        ["3840x1440", "3840 × 1440 (24:9)"],
        ["5120x1440", "5120 × 1440 (32:9)"]
      ],
      "default": "native"
    },
    {
      "key": "upscaler",
      "label": {"en": "Upscaler", "fr": "Mise à l’échelle"},
